backend/node_modules/
frontend/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Environment variables (NEVER commit these!)
.env
.env.local
backend/.env
backend/.env.local
frontend/.env
