# Secrets and credentials
backend/service-account.json
backend/vision-key.json
**/service-account*.json
**/*-key.json

# Render config (contains sensitive structure)
backend/render.yaml

# Build / distribution folders
frontend/dist/
backend/dist/

# Optional: IDE / editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Optional: npm package lock files if you don't want to track them
